# Azure IoT Hub Connection String for the device
AZURE_IOTHUB_CONNECTION_STRING=HostName=<your-iothub-name>.azure-devices.net;DeviceId=<your-device-id>;SharedAccessKey=<your-device-key>

# ESP32 seri port ayarları
SERIAL_PORT=/dev/ttyUSB0
BAUD_RATE=115200
SERIAL_TIMEOUT_SECONDS=1.0
SERIAL_RECONNECT_INTERVAL=5.0
AZURE_RECONNECT_INTERVAL=10.0
LOG_LEVEL=INFO
